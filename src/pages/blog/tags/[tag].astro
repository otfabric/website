---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/site/PageHeader.astro';
import PostList from '../../../components/blog/PostList.astro';
import TagList from '../../../components/blog/TagList.astro';
import { getPosts, getTags } from '../../../data/blog';
import { breadcrumbs } from '../../../data/seo';
import { getStandards } from '../../../data/standards';

export async function getStaticPaths() {
	return (await getTags()).map(([tag]) => ({ params: { tag } }));
}

const { tag } = Astro.params;
const posts = (await getPosts()).filter((post) => post.data.tags.includes(tag));
// Tags that name a protocol, model or profile read better by its name: "posts about KNX", not "tagged knx".
const subject = (await getStandards()).find((s) => s.id === tag)?.data.name ?? tag.replace(/-/g, ' ');
const description = `${posts.length} OT Fabric blog post${posts.length === 1 ? '' : 's'} about ${subject}: ${posts.map((p) => p.data.title).join('; ')}.`;
---

<BaseLayout
	title={`#${tag}`}
	description={description}
	pageType="CollectionPage"
	schema={[breadcrumbs([{ name: 'Blog', path: '/blog/' }, { name: `#${tag}`, path: `/blog/tags/${tag}/` }])]}
>
	<PageHeader label="Blog" title={`#${tag}`} lead={`${posts.length} post${posts.length === 1 ? '' : 's'} tagged ${tag}.`} />
	<div class="ot-container">
		<TagList current={tag} />
		<PostList posts={posts} />
	</div>
</BaseLayout>
