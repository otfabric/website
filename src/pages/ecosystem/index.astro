---
// /ecosystem/ moved to /ecosystem/implementations/ when the section gained the
// standards and alliances directory. Static hosting has no server-side redirect
// that keeps the query string, so this page forwards ?protocol= and ?stack= links
// in the browser and tells crawlers where the page lives now.
const target = '/ecosystem/implementations/';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<title>Ecosystem map moved</title>
		<meta name="robots" content="noindex" />
		<link rel="canonical" href={new URL(target, Astro.site)} />
		<meta http-equiv="refresh" content={`0; url=${target}`} />
		<script is:inline define:vars={{ target }}>
			location.replace(target + location.search + location.hash);
		</script>
	</head>
	<body>
		<p>The ecosystem map has moved to <a href={target}>{target}</a>.</p>
	</body>
</html>
