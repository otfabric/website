---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/site/PageHeader.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';
import Video from '../../components/Video.astro';
import { Image, getImage } from 'astro:assets';
import { categories, getProjects, repoUrl, type Project } from '../../data/projects';
import { getStandards, kindOf, standardPath } from '../../data/standards';
import { projectMedia } from '../../data/project-media';
import { absolute, breadcrumbs, orgRef } from '../../data/seo';

export async function getStaticPaths() {
	const projects = (await getProjects()).filter((p) => p.data.status === 'available');
	return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

interface Props {
	project: Project;
}
const { project } = Astro.props;
const { data } = project;
const category = categories.find((c) => c.id === data.category)!;
const standards = await getStandards();
// What the project implements, and what it builds on or works with, each in the project's own order.
const pick = (ids: string[]) => ids.map((id) => standards.find((s) => s.id === id)!);
const implemented = pick(data.standards);
const worksWith = pick(data.related);
const own = [...data.standards, ...data.related];
const related = (await getProjects()).filter(
	(p) => p.id !== project.id && p.data.status === 'available' && [...p.data.standards, ...p.data.related].some((id) => own.includes(id)),
);
// Tools ship release binaries; libraries are installed with go get.
const releases =
	data.category === 'cli' || data.category === 'ui' || (data.category === 'discovery' && !data.install)
		? `${repoUrl(data.repo!)}/releases`
		: undefined;
const media = projectMedia[project.id];
const screenshotUrl = media?.screenshot && (await getImage({ src: media.screenshot.src, width: 1200, format: 'png' })).src;
const url = absolute(`/projects/${project.id}/`);
// Search terms for each kind of project, next to the protocol names.
const categoryKeywords: Record<typeof data.category, string[]> = {
	protocol: ['protocol library', 'client', 'server'],
	'information-model': ['information model', 'data model', 'semantics'],
	'application-profile': ['application profile', 'messaging'],
	cli: ['command-line tool', 'CLI'],
	transport: ['transport layer'],
	discovery: ['network visibility', 'network discovery', 'protocol fingerprinting'],
	interop: ['interoperability testing', 'reference implementations', 'Docker'],
	ui: ['desktop app'],
	mcp: ['Model Context Protocol', 'AI agents'],
	gateway: ['IT/OT integration', 'data connectors'],
};
// The browser and search title says what the project is: "go-modbus: Modbus library".
const what: Record<string, string> = {
	'go-modbus-capture': 'Modbus capture format (MBCAP)',
	'go-modbus-trace': 'Modbus/TCP packet trace reader',
	'go-mms': 'MMS (ISO 9506) library',
	'go-iec61850-model': 'IEC 61850 information model and NSD library',
	nsdctl: 'IEC 61850 NSD and information model CLI',
	'go-sunspec': 'SunSpec Modbus information model library',
	'modbus-simulator': 'Modbus device simulator',
	'go-cotp': 'COTP (ISO 8073) transport',
	'go-tpkt': 'TPKT (RFC 1006) framing',
	'go-serial': 'RS-232 and RS-485 serial ports',
	'go-otfp': 'OT protocol fingerprinting library',
	otprobe: 'OT protocol detection and device identification CLI',
	'lan-tracker': 'OT network visibility',
	'modbus-trace-explorer': 'Modbus/TCP trace viewer',
};
const kind = { protocol: 'library', 'information-model': 'library', 'application-profile': 'library', cli: 'command-line tool', interop: 'interop test suite', ui: 'desktop app' } as Record<string, string>;
const topic = implemented[0]?.data.name;
const pageTitle = what[project.id] ?? (topic && kind[data.category] ? `${data.name}: ${topic} ${kind[data.category]}` : data.name);
const fullName = pageTitle.startsWith(data.name) ? pageTitle : `${data.name}: ${pageTitle}`;
const schema = [
	breadcrumbs([
		{ name: 'Projects', path: '/projects/' },
		{ name: data.name, path: `/projects/${project.id}/` },
	]),
	{
		'@type': 'SoftwareSourceCode',
		'@id': `${url}#software`,
		name: data.name,
		description: data.description,
		url,
		codeRepository: repoUrl(data.repo!),
		programmingLanguage: data.category === 'ui' ? ['Go', 'TypeScript'] : 'Go',
		applicationCategory: category.label,
		author: orgRef,
		publisher: orgRef,
		isAccessibleForFree: true,
		keywords: ['OT', 'industrial automation', ...categoryKeywords[data.category], ...implemented.map((s) => s.data.name)].join(', '),
		...(implemented.length && {
			about: implemented.map((s) => ({ '@type': 'Thing', name: s.data.name, url: absolute(standardPath(s)) })),
		}),
		...(worksWith.length && {
			mentions: worksWith.map((s) => ({ '@type': 'Thing', name: s.data.name, url: absolute(standardPath(s)) })),
		}),
		mainEntityOfPage: { '@id': `${url}#webpage` },
	},
	// Tools people download and run also describe themselves as applications.
	...(releases
		? [
				{
					'@type': 'SoftwareApplication',
					'@id': `${url}#app`,
					name: data.name,
					description: data.description,
					url,
					applicationCategory: data.category === 'discovery' ? 'NetworkingApplication' : 'DeveloperApplication',
					...(data.category === 'ui' && { operatingSystem: 'macOS, Windows, Linux' }),
					downloadUrl: `${releases}/latest`,
					offers: { '@type': 'Offer', price: 0, priceCurrency: 'USD' },
					isAccessibleForFree: true,
					...(screenshotUrl && { screenshot: absolute(screenshotUrl) }),
					author: orgRef,
					publisher: orgRef,
				},
			]
		: []),
];
---

<BaseLayout title={fullName} description={data.description} schema={schema}>
	<PageHeader label={category.label} title={data.name} lead={data.description}>
		<div class="actions">
			<a class="ot-btn primary" href={repoUrl(data.repo!)}>View on GitHub</a>
			{releases && <a class="ot-btn" href={releases}>Download a release</a>}
			{data.install?.startsWith('go get') && (
				<a class="ot-btn" href={`https://pkg.go.dev/github.com/otfabric/${data.repo}`}>API reference</a>
			)}
		</div>
	</PageHeader>

	{media?.screenshot && (
		<div class="ot-container">
			<figure class="shot">
				<Image src={media.screenshot.src} alt={media.screenshot.alt} widths={[720, 1200, 1800]} sizes="(min-width: 72rem) 68rem, 100vw" loading="eager" />
				{media.screenshot.caption && <figcaption>{media.screenshot.caption}</figcaption>}
			</figure>
		</div>
	)}

	<div class="ot-container ot-prose">
		{data.highlights && (
			<>
				<h2>What it does</h2>
				<ul>
					{data.highlights.map((item) => <li>{item}</li>)}
				</ul>
			</>
		)}
		{media?.video && (
			<>
				<h2>See it in action</h2>
				<Video src={media.video.src} poster={media.video.poster} caption={media.video.caption} />
			</>
		)}
		{data.install && (
			<>
				<h2>Install</h2>
				<pre><code>{data.install}</code></pre>
			</>
		)}
		{implemented.length > 0 && (
			<>
				<h2>{implemented.every((s) => s.data.kind === 'protocol') ? 'Protocols' : 'Standards'}</h2>
				<ul>
					{implemented.map((s) => <li><a href={standardPath(s)}>{s.data.name}</a>{s.data.kind !== 'protocol' && ` (${kindOf(s.data.kind).label.toLowerCase()})`}: {s.data.summary}</li>)}
				</ul>
			</>
		)}
		{worksWith.length > 0 && (
			<>
				<h2>Works with</h2>
				<ul>
					{worksWith.map((s) => <li><a href={standardPath(s)}>{s.data.name}</a>{s.data.kind !== 'protocol' && ` (${kindOf(s.data.kind).label.toLowerCase()})`}: {s.data.summary}</li>)}
				</ul>
			</>
		)}
		<p>The README on <a href={repoUrl(data.repo!)}>GitHub</a> has the full feature list, examples and changelog.</p>
	</div>

	{related.length > 0 && (
		<div class="ot-container">
			<h2 class="related">Related projects</h2>
			<ProjectGrid projects={related} />
		</div>
	)}
</BaseLayout>

<style>
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.75rem;
	}
	pre {
		padding: 0.9rem 1rem;
		border: 1px solid var(--ot-line);
		border-radius: 0.25rem;
		background: var(--ot-surface);
		overflow-x: auto;
	}
	.shot {
		margin: 0 0 1rem;
	}
	.shot img {
		display: block;
		width: 100%;
		height: auto;
		border: 1px solid var(--ot-line);
		border-radius: 0.25rem;
	}
	.shot figcaption {
		margin-top: 0.5rem;
		font-size: 0.875rem;
		color: var(--ot-muted);
	}
	.related {
		margin: 4rem 0 1.25rem;
		font-size: 1.8rem;
	}
</style>
