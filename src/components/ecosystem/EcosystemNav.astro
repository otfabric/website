---
// Section navigation inside Ecosystem: the software map and the organizations directory.
interface Props {
	wide?: boolean;
}
const { wide = false } = Astro.props;
const path = Astro.url.pathname;
const links = [
	{ label: 'Software', sub: 'Implementations', href: '/ecosystem/implementations/' },
	{ label: 'Organizations', sub: 'Standards & alliances', href: '/ecosystem/organizations/' },
];
---

<nav class="eco-nav" aria-label="Ecosystem">
	<div class:list={['ot-container', { wide }]}>
		<span class="ot-label">Ecosystem</span>
		<ul>
			{links.map((l) => (
				<li>
					<a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>
						{l.label}
						<span>{l.sub}</span>
					</a>
				</li>
			))}
		</ul>
	</div>
</nav>

<style>
	.eco-nav {
		border-bottom: 1px solid var(--ot-line);
		background: var(--ot-surface);
	}
	.eco-nav .ot-container {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		overflow-x: auto;
	}
	.wide {
		max-width: 92rem;
	}
	ul {
		display: flex;
		gap: 0.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	li {
		margin: 0;
	}
	a {
		display: flex;
		align-items: baseline;
		gap: 0.45rem;
		padding: 0.8rem 0.75rem 0.7rem;
		border-bottom: 2px solid transparent;
		font: 600 0.95rem/1 var(--ot-font-body);
		color: var(--ot-fg);
		text-decoration: none;
		white-space: nowrap;
	}
	a span {
		font: 400 0.8rem/1 var(--ot-font-body);
		color: var(--ot-muted);
	}
	a:hover,
	a[aria-current='page'] {
		color: var(--ot-accent);
	}
	a[aria-current='page'] {
		border-bottom-color: var(--ot-accent);
	}
	@media (max-width: 30rem) {
		a span {
			display: none;
		}
	}
</style>
