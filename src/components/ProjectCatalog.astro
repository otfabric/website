---
import { categories, getProjects } from '../data/projects';
import { getStandards, kinds, shortName } from '../data/standards';
import ProjectGrid from './ProjectGrid.astro';

const projects = await getProjects();
const standards = await getStandards();
// One filter row, the standards grouped by kind; kinds without standards are left out.
const groups = kinds.map((k) => ({ kind: k, items: standards.filter((s) => s.data.kind === k.id) })).filter((g) => g.items.length);
// Categories without projects yet (application-profile libraries) stay out of the catalog.
const sections = categories.filter((c) => projects.some((p) => p.data.category === c.id));
// Projects per filter, counted the way the filter matches: implements or works with.
const count = (id: string) => projects.filter((p) => [...p.data.standards, ...p.data.related].includes(id)).length;
---

<div class="ot-catalog not-content">
	<div class="ot-filters" role="group" aria-label="Filter by protocol, information model or profile">
		<button type="button" class="all" data-filter="" aria-pressed="true">
			<span class="name">All projects</span>
			<span class="count">{projects.length}</span>
		</button>
		{groups.map((g) => (
			<>
				<span class="ot-filter-kind">{g.kind.plural}</span>
				{g.items.map((s) => (
					<button type="button" class:list={{ 'is-layered': s.data.kind !== 'protocol' }} data-filter={s.id} aria-pressed="false" title={s.data.name}>
						{s.data.icon && <img src={`/icons/${s.data.icon}.svg`} alt="" width="22" height="22" />}
						<span class="name">{shortName(s)}</span>
						<span class="count">{count(s.id)}</span>
					</button>
				))}
			</>
		))}
	</div>

	{sections.map((category) => (
		<section class="ot-group">
			<h2 id={category.id}>{category.label}</h2>
			<p class="ot-group-desc">{category.description}</p>
			<ProjectGrid projects={projects.filter((p) => p.data.category === category.id)} />
			<p class="ot-empty" hidden>No {category.label.toLowerCase()} for this standard yet.</p>
		</section>
	))}
</div>

<script>
	const root = document.querySelector('.ot-catalog');
	const buttons = root?.querySelectorAll<HTMLButtonElement>('[data-filter]') ?? [];

	function apply(filter: string) {
		buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === filter)));
		root?.querySelectorAll<HTMLElement>('.ot-group').forEach((group) => {
			let visible = 0;
			group.querySelectorAll<HTMLElement>('.ot-project').forEach((card) => {
				const match = !filter || (card.dataset.standards ?? '').split(' ').includes(filter);
				card.hidden = !match;
				if (match) visible++;
			});
			const empty = group.querySelector<HTMLElement>('.ot-empty');
			if (empty) empty.hidden = visible > 0;
		});
	}

	buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.filter ?? '')));
</script>

<style>
	/* Same look as the protocol picker of the ecosystem map: a wrapping grid of tiles with
	   icons and counts, one labelled row per kind of standard. */
	.ot-filters {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(12.5rem, 1fr));
		gap: 0.5rem;
		margin-bottom: 2.5rem;
	}
	.ot-filter-kind {
		grid-column: 1 / -1;
		margin-top: 0.35rem;
		font: 500 0.7rem/1 var(--ot-font-mono);
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: var(--ot-muted);
	}
	.ot-filters button {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		min-width: 0;
		min-height: 2.45rem;
		padding: 0.5rem 0.7rem 0.5rem 0.5rem;
		border: 1px solid var(--ot-line);
		border-radius: 0.5rem;
		background: var(--ot-surface);
		color: var(--ot-fg);
		font: 500 0.92rem/1.2 var(--ot-font-body);
		text-align: left;
		cursor: pointer;
		transition: border-color 0.15s, background-color 0.15s;
	}
	.ot-filters button.all {
		padding-left: 0.75rem;
	}
	.ot-filters button:hover {
		border-color: var(--ot-accent);
	}
	.ot-filters button:focus-visible {
		outline: 2px solid var(--ot-accent);
		outline-offset: 2px;
	}
	.ot-filters button[aria-pressed='true'] {
		border-color: var(--ot-accent);
		background: var(--ot-accent-soft);
		color: var(--ot-fg-strong);
		box-shadow: inset 0 0 0 1px var(--ot-accent);
	}
	/* Models and profiles sit on top of a protocol: dashed, as profiles are on the map. */
	.ot-filters button.is-layered {
		border-style: dashed;
	}
	.ot-filters img {
		flex: none;
		border-radius: 0.3rem;
	}
	.ot-filters .name {
		flex: 1;
		min-width: 0;
		overflow-wrap: anywhere;
	}
	.ot-filters .count {
		flex: none;
		min-width: 1.75rem;
		padding: 0.2rem 0.4rem;
		border-radius: 999px;
		background: var(--ot-bg);
		font: 500 0.72rem/1 var(--ot-font-mono);
		text-align: center;
		color: var(--ot-muted);
	}
	.ot-filters button[aria-pressed='true'] .count {
		color: var(--ot-fg-strong);
	}
	@media (max-width: 40rem) {
		.ot-filters {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		.ot-filters button {
			font-size: 0.85rem;
		}
	}
	.ot-group + .ot-group {
		margin-top: 3rem;
	}
	.ot-group h2 {
		font-size: 1.6rem;
		margin: 0;
		scroll-margin-top: 5rem;
	}
	.ot-group-desc {
		margin: 0.3rem 0 1.1rem;
		color: var(--ot-muted);
		font-size: 0.9rem;
	}
	.ot-empty {
		color: var(--ot-muted);
		font-size: 0.9rem;
	}
</style>
