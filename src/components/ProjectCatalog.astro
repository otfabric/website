---
import { categories, getProjects } from '../data/projects';
import { getStandards, kinds, shortName } from '../data/standards';
import ProjectGrid from './ProjectGrid.astro';

const projects = await getProjects();
const standards = await getStandards();
// One filter row, the standards grouped by kind; kinds without standards are left out.
const groups = kinds.map((k) => ({ kind: k, items: standards.filter((s) => s.data.kind === k.id) })).filter((g) => g.items.length);
// Categories without projects yet (application-profile libraries) stay out of the catalog.
const sections = categories.filter((c) => projects.some((p) => p.data.category === c.id));
---

<div class="ot-catalog not-content">
	<div class="ot-filters" role="group" aria-label="Filter by protocol or information model">
		<span class="ot-label">Standard</span>
		<button type="button" data-filter="" aria-pressed="true">All</button>
		{groups.map((g) => (
			<>
				<span class="ot-filter-kind">{g.kind.plural}</span>
				{g.items.map((s) => <button type="button" data-filter={s.id} aria-pressed="false">{shortName(s)}</button>)}
			</>
		))}
	</div>

	{sections.map((category) => (
		<section class="ot-group">
			<h2 id={category.id}>{category.label}</h2>
			<p class="ot-group-desc">{category.description}</p>
			<ProjectGrid projects={projects.filter((p) => p.data.category === category.id)} />
			<p class="ot-empty" hidden>No {category.label.toLowerCase()} for this standard yet.</p>
		</section>
	))}
</div>

<script>
	const root = document.querySelector('.ot-catalog');
	const buttons = root?.querySelectorAll<HTMLButtonElement>('[data-filter]') ?? [];

	function apply(filter: string) {
		buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === filter)));
		root?.querySelectorAll<HTMLElement>('.ot-group').forEach((group) => {
			let visible = 0;
			group.querySelectorAll<HTMLElement>('.ot-project').forEach((card) => {
				const match = !filter || (card.dataset.standards ?? '').split(' ').includes(filter);
				card.hidden = !match;
				if (match) visible++;
			});
			const empty = group.querySelector<HTMLElement>('.ot-empty');
			if (empty) empty.hidden = visible > 0;
		});
	}

	buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.filter ?? '')));
</script>

<style>
	.ot-filters {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem;
		margin-bottom: 2rem;
	}
	.ot-filters .ot-label {
		margin-right: 0.4rem;
	}
	.ot-filter-kind {
		margin: 0 0.1rem 0 0.6rem;
		font-size: 0.75rem;
		color: var(--ot-muted);
	}
	.ot-filters button {
		font: 500 0.8rem/1 var(--ot-font-body);
		padding: 0.45rem 0.75rem;
		border: 1px solid var(--ot-line);
		border-radius: 999px;
		background: transparent;
		color: var(--ot-fg);
		cursor: pointer;
	}
	.ot-filters button[aria-pressed='true'] {
		background: var(--ot-accent);
		border-color: var(--ot-accent);
		color: var(--ot-bg);
	}
	.ot-group + .ot-group {
		margin-top: 3rem;
	}
	.ot-group h2 {
		font-size: 1.6rem;
		margin: 0;
		scroll-margin-top: 5rem;
	}
	.ot-group-desc {
		margin: 0.3rem 0 1.1rem;
		color: var(--ot-muted);
		font-size: 0.9rem;
	}
	.ot-empty {
		color: var(--ot-muted);
		font-size: 0.9rem;
	}
</style>
