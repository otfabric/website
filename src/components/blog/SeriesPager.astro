---
// Previous and next part of the "Software architecture for OT" series, shown on every post
// of the series. Parts that are not published yet are skipped.
import { protocolSeries, publishedSeriesIds } from '../../data/series';

interface Props {
	current: string;
}
const { current } = Astro.props;
const live = await publishedSeriesIds();
const parts = protocolSeries.parts.filter((p) => live.has(p.id) || p.id === current);
const i = parts.findIndex((p) => p.id === current);
const label = (id: string) => {
	const n = protocolSeries.parts.findIndex((p) => p.id === id);
	return n === 0 ? 'Guide' : `Part ${n} of ${protocolSeries.parts.length - 1}`;
};
const prev = i > 0 ? parts[i - 1] : undefined;
const next = i >= 0 && i < parts.length - 1 ? parts[i + 1] : undefined;
---

{i >= 0 && (
	<nav class="ot-series-pager" aria-label="Previous and next in this series">
		<p class="ot-label">Software architecture for OT · {label(current)}</p>
		<div class="row">
			{prev ? (
				<a href={`/blog/${prev.id}/`} rel="prev">
					<span class="ot-label">← Previous · {label(prev.id)}</span>
					{prev.short}
				</a>
			) : <span />}
			{next ? (
				<a class="next" href={`/blog/${next.id}/`} rel="next">
					<span class="ot-label">Next · {label(next.id)} →</span>
					{next.short}
				</a>
			) : (
				<a class="next" href={`/blog/${protocolSeries.hub}/`}>
					<span class="ot-label">Back to the start →</span>
					{protocolSeries.parts[0].short}
				</a>
			)}
		</div>
	</nav>
)}

<style>
	.ot-series-pager {
		max-width: 46rem;
		margin-top: 3rem;
		padding: 1.1rem 1.2rem;
		border: 1px solid var(--ot-line);
		border-radius: 0.375rem;
	}
	.ot-series-pager > p {
		margin: 0 0 0.9rem;
	}
	.row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
	}
	a {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		padding: 0.8rem 0.9rem;
		border: 1px solid var(--ot-line);
		border-radius: 0.25rem;
		text-decoration: none;
		font-weight: 500;
	}
	a:hover {
		border-color: var(--ot-accent);
	}
	.next {
		text-align: end;
	}
	@media (max-width: 36rem) {
		.row {
			grid-template-columns: 1fr;
		}
		.next {
			text-align: start;
		}
	}
</style>
