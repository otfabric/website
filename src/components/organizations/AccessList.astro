---
// The eight access questions for one organization, each with its answer, detail and source.
import Answer from './Answer.astro';
import { formatDay, host, questions, type Organization } from '../../data/organizations';

interface Props {
	org: Organization;
}
const { org } = Astro.props;
---

<dl class="access">
	{questions.map((q) => {
		const c = org.data.access[q.key];
		return (
			<div>
				<dt>{q.label}</dt>
				<dd>
					<Answer answer={c.answer} label />
					<span class="detail">
						{c.detail}
						{c.source && (
							<>
								{' '}
								<a href={c.source} rel="noopener">{host(c.source)}</a>
								{c.verifiedAt && <span class="muted">, checked {formatDay(c.verifiedAt)}</span>}
							</>
						)}
					</span>
				</dd>
			</div>
		);
	})}
</dl>

<style>
	.access {
		display: grid;
		gap: 0;
		margin: 0;
	}
	.access > div {
		display: grid;
		gap: 0.4rem;
		padding: 0.8rem 0;
		border-bottom: 1px solid var(--ot-line);
	}
	@media (min-width: 48rem) {
		.access > div {
			grid-template-columns: 16rem 1fr;
			gap: 1.25rem;
		}
	}
	dt {
		font-weight: 600;
		color: var(--ot-fg-strong);
		font-size: 0.92rem;
	}
	dd {
		display: flex;
		align-items: flex-start;
		gap: 0.75rem;
		margin: 0;
		font-size: 0.92rem;
	}
	dd :global(.ans) {
		flex: none;
		min-width: 6.5rem;
		justify-content: flex-start;
	}
	.detail {
		color: var(--ot-fg);
	}
	.detail a {
		color: var(--ot-accent);
		font-size: 0.85rem;
	}
	.muted {
		color: var(--ot-muted);
		font-size: 0.85rem;
	}
</style>
