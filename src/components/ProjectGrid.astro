---
import ProjectCard from './ProjectCard.astro';
import type { Project } from '../data/projects';
import { getStandards, shortName } from '../data/standards';

interface Props {
	projects: Project[];
}
const { projects } = Astro.props;
const names = Object.fromEntries((await getStandards()).map((s) => [s.id, shortName(s)]));
---

<div class="ot-grid not-content">
	{projects.map((project) => <ProjectCard project={project} names={names} />)}
</div>

<style>
	.ot-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
		gap: 1rem;
	}
</style>
