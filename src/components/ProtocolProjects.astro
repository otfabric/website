---
import { categories, projects, type ProtocolId } from '../data/projects';
import ProjectCard from './ProjectCard.astro';

interface Props {
	protocol: ProtocolId;
}

const { protocol } = Astro.props;
const order = categories.map((c) => c.id);
const items = projects
	.filter((p) => p.status === 'available' && p.protocols.includes(protocol))
	.sort((a, b) => order.indexOf(a.category) - order.indexOf(b.category));
---

<div class="ot-grid not-content">
	{items.map((project) => <ProjectCard project={project} />)}
</div>

<style>
	.ot-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
		gap: 0.9rem;
		margin-top: 1rem;
	}
</style>
